# Скопируйте этот файл в `.env` и заполните значениями из вашего проекта Supabase.
# ВАЖНО: в клиент попадают только публичные ключи (префикс EXPO_PUBLIC_).
# Секретные ключи (service_role, Gemini API key и т.п.) сюда НЕ кладём —
# они живут только в секретах Supabase Edge Functions.

# URL проекта Supabase, напр. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Публичный anon-ключ Supabase (безопасен для клиента при включённом RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
